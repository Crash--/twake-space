{
  "name": "@twake-space/backend",
  "version": "0.1.29",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@linagora/ldap-rest-client": "1.6.0",
    "@linagora/rabbitmq-client": "^0.7.1",
    "@sentry/node": "^11.4.0",
    "amqplib": "^0.10.9",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
