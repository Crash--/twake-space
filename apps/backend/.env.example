# amqps:// for TLS; NODE_EXTRA_CA_CERTS adds a private CA.
AMQP_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=postgres://twake_space:twake_space@localhost:5432/twake_space
HTTP_PORT=8080
METRICS_PORT=9464
LOG_LEVEL=info
LDAP_REST_URL=http://localhost:8081
LDAP_REST_SERVICE_ID=twake-space
LDAP_REST_SECRET=
OIDC_ISSUER=https://sign-up.twake.app/
OIDC_CLIENT_SECRET=
# Errors and logs go to Sentry when set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging

# Single installation: one homeserver for every organization, set both or none.
# MATRIX_HOMESERVER_URL=https://matrix.example.com
# MATRIX_SERVER_NAME=example.com
# In SaaS, instead of MATRIX_*: the chat control plane gives each tenant's
# homeserver.
# CHAT_CONTROL_PLANE_URL=https://control-plane.example.com/api/v1/deployments
# CHAT_CONTROL_PLANE_TOKEN=
# How Synapse's SSO mapping builds Matrix localparts: from the LDAP uid, or the
# local part of the email.
MATRIX_LOCALPART=uid
